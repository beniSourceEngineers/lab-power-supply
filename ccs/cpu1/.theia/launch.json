                {
                    "name": "Texas Instruments XDS100v2 USB Debug Probe_0",
                    "cores": [
                        {
                            "name": "C28xx_CPU1",
                            "program": "${workspaceFolder}/../cpu1/CPU1_FLASH/labpsu_cpu1.out"
                        },
                        {
                            "name": "C28xx_CPU2",
                            "program": "${workspaceFolder}/../cpu2/CPU2_FLASH/labpsu_cpu2.out"
                        }
